<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Dragnet — {{ today }}</title>
</head>
<body style="margin:0;padding:24px;background:#0f0e1a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#e8e5f7;">

<div style="max-width:680px;margin:0 auto;">

<div style="border-bottom:1px solid #3a3461;padding-bottom:16px;margin-bottom:24px;">
  <h1 style="margin:0;font-size:24px;font-weight:600;color:#e8e5f7;letter-spacing:-0.01em;">
    DRAGNET <span style="color:#9b8dd6;font-weight:400;">&middot;</span> <span style="color:#9b8dd6;font-weight:400;">{{ today }}</span>
  </h1>
  <p style="margin:8px 0 0 0;color:#9b8dd6;font-size:14px;">
    {{ total }} new posting{% if total != 1 %}s{% endif %} since the last run.
  </p>
</div>

{% for p in postings %}
<div style="background:#1a1830;border:1px solid #2d2750;border-radius:8px;padding:16px;margin-bottom:14px;">

  <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px;">
    <div style="font-size:16px;font-weight:600;color:#e8e5f7;line-height:1.3;">
      {{ p.title }}
    </div>
    <div style="background:#3a3461;color:#d4c5f9;font-size:12px;padding:2px 8px;border-radius:4px;font-weight:600;white-space:nowrap;margin-left:12px;">
      {{ "%.0f"|format(p.score) }}
    </div>
  </div>

  <div style="color:#d4c5f9;font-size:14px;margin-bottom:8px;">
    {{ p.company }} <span style="color:#6f6695;">&middot;</span> {{ p.location }}
  </div>

  <div style="color:#9b8dd6;font-size:12px;margin-bottom:10px;">
    <span style="color:#ff7eb6;">{{ p.source }}</span>
    {% if p.matched_categories %} <span style="color:#6f6695;">&middot;</span> {{ p.matched_categories | join(" + ") }}{% endif %}
    {% if p.signals_summary() and p.signals_summary() != "—" %} <span style="color:#6f6695;">&middot;</span> {{ p.signals_summary() }}{% endif %}
    {% if p.posted_at %} <span style="color:#6f6695;">&middot;</span> {{ p.posted_at.strftime("%b %d") }}{% endif %}
  </div>

  <div>
    <a href="{{ p.url }}" style="color:#ff7eb6;font-size:13px;font-weight:500;text-decoration:none;">
      Apply &rarr;
    </a>
  </div>

</div>
{% endfor %}

<div style="margin-top:24px;padding-top:16px;border-top:1px solid #2d2750;color:#6f6695;font-size:11px;text-align:center;">
  Generated by dragnet. Edit <code style="color:#9b8dd6;">config.yaml</code> to tune scoring or filtering.
</div>

</div>
</body>
</html>

# Copy to .env (gitignored) and fill in. All four are free-tier.

# === USAJobs ===
# Register at https://developer.usajobs.gov/apirequest/
# The User-Agent must be the email you registered with.
USAJOBS_AUTH_KEY=
USAJOBS_USER_AGENT_EMAIL=

# === Adzuna ===
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# === JSearch (RapidAPI) ===
# Sign up at https://rapidapi.com, then subscribe to JSearch (free tier 200/mo)
# at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# === Gmail SMTP ===
# Generate an app password at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Google account).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
